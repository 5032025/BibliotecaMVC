@model IEnumerable<PrimerSemana.Models.Autor>

@{
    ViewData["Title"] = "Autores";
}

<div class="container mt-5">
    <div class="row">
        @foreach (var autor in Model)
        {
            <div class="col-md-4 mb-4">
                <div class="card h-100 border-0 shadow-sm custom-card bg-dark text-white">
                    <div class="card-body p-4 text-center">
                        <!-- Imagen del autor apuntando a wwwroot/images/ -->
                        <img src="~/images/@autor.Imagen"
                             alt="@autor.Name"
                             class="img-fluid rounded-circle mb-4 shadow-sm"
                             style="width: 150px; height: 150px; object-fit: cover; border: 3px solid #334155;">

                        <h5 class="card-title fw-bold mb-3">@autor.Name</h5>

                        <p class="card-text mb-1 text-start">
                            <i class="bi bi-globe me-2"></i><strong>Nacionalidad:</strong> @autor.Nationality
                        </p>

                        <p class="card-text mb-4 text-start">
                            <i class="bi bi-calendar-event me-2"></i><strong>Nacimiento:</strong> @autor.BirthDate
                        </p>

                        <a href="#" class="text-decoration-none fw-bold d-block text-start text-warning">Ver libros del autor →</a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>