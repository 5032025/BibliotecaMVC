@model IEnumerable<PrimerSemana.Models.Prestamo>

@{
    ViewData["Title"] = "Reservations";
}

<div class="container mt-5">
    <h2 class="text-white fw-bold mb-3">Reservations</h2>

    <div class="card bg-dark border-secondary shadow-sm">
        <div class="card-body p-0">
            <table class="table table-dark table-hover mb-0">
                <thead>
                    <tr class="text-muted small">
                        <th class="p-3">BOOK / AUTHOR</th>
                        <th class="p-3">USER ID</th>
                        <th class="p-3">EXPIRATION</th>
                        <th class="p-3 text-end">STATUS</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model)
                    {
                        <tr>
                            <td class="p-3">
                                <div class="fw-bold text-white">@r.Libro</div>
                                <div class="text-muted small">by @r.Autor</div>
                            </td>
                            <td class="p-3 text-white">@r.UserId</td>
                            <td class="p-3 text-white">@r.ExpirationDate.ToString("d MMM yyyy")</td>
                            <td class="p-3 text-end">
                                @{
                                    string badgeClass = r.Status switch
                                    {
                                        PrimerSemana.Models.ReserveStatus.Active => "bg-primary",
                                        PrimerSemana.Models.ReserveStatus.Cancelled => "bg-danger",
                                        _ => "bg-secondary" // Completed
                                    };
                                }
                                <span class="badge @badgeClass px-3 py-2">@r.Status</span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>