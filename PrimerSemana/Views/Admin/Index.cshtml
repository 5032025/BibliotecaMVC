@{
    ViewData["Title"] = "Panel de Administración";
}

<div class="container mt-4 text-white">
    <div class="p-5 mb-4 rounded-3" style="background-color: #1c2541;">
        <div class="container-fluid py-3">
            <h1 class="display-5 fw-bold text-warning">Panel de Administrador</h1>
            <p class="col-md-8 fs-4 text-light">Bienvenido al núcleo de control de BlibioCore. Desde aquí puedes supervisar el sistema y gestionar las entidades principales.</p>
            <hr class="my-4 border-secondary">

            <div class="row g-3">
                <div class="col-md-3">
                    <div class="p-3 bg-dark rounded border border-secondary h-100 d-flex flex-column justify-content-between">
                        <div>
                            <h5 class="text-warning">Gestión de Libros</h5>
                            <p class="small text-muted">Añade, edita o cambia la disponibilidad de los libros.</p>
                        </div>
                        <a asp-controller="Book" asp-action="Index" class="btn btn-sm btn-outline-warning mt-2">Ir a Libros</a>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="p-3 bg-dark rounded border border-secondary h-100 d-flex flex-column justify-content-between">
                        <div>
                            <h5 class="text-warning">Gestión de Autores</h5>
                            <p class="small text-muted">Registra autores o cambia su estado de activación.</p>
                        </div>
                        <a asp-controller="Autor" asp-action="Index" class="btn btn-sm btn-outline-warning mt-2">Ir a Autores</a>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="p-3 bg-dark rounded border border-secondary h-100 d-flex flex-column justify-content-between">
                        <div>
                            <h5 class="text-warning">Gestión de Categorías</h5>
                            <p class="small text-muted">Administra las categorías de los libros.</p>
                        </div>
                        <a asp-controller="Categoria" asp-action="Index" class="btn btn-sm btn-outline-warning mt-2">Ir a Categorías</a>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="p-3 bg-dark rounded border border-secondary h-100 d-flex flex-column justify-content-between">
                        <div>
                            <h5 class="text-warning">Sesión</h5>
                            <p class="small text-muted">Cierra tu sesión de administrador de forma segura.</p>
                        </div>
                        <a asp-controller="Account" asp-action="Logout" class="btn btn-sm btn-outline-danger mt-2">Cerrar Sesión</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>