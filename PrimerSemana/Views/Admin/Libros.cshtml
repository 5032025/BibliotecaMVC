@model IEnumerable<PrimerSemana.Models.Libro>

@{
    ViewData["Title"] = "Gestión de Libros";
}

<div class="container mt-4 text-white">
    <h2 class="text-warning mb-4">Gestión de Libros</h2>

    <div class="card p-4 mb-5" style="background-color: #1c2541; border: none;">
        <h4 id="form-titulo-libro" class="mb-3 text-white">Registrar Nuevo Libro</h4>

        <form id="libro-form" asp-action="Create" method="post" class="row g-3" onsubmit="confirmarGuardar(event, 'libro-form', document.getElementById('LibroId').value !== '0' ? '¿Deseas actualizar los datos de este libro?' : '¿Deseas registrar un nuevo libro?')">
            <input type="hidden" id="LibroId" name="Id" value="0" />
            <input type="hidden" name="Imagen" value="default.png" />

            <div asp-validation-summary="All" class="text-danger fw-bold col-12"></div>

            <div class="col-md-4">
                <label class="form-label text-white-50">Título</label>
                <input type="text" id="Title" name="Title" class="form-control bg-dark text-white border-secondary" required />
            </div>
            <div class="col-md-4">
                <label class="form-label text-white-50">Género</label>
                <input type="text" id="Genre" name="Genre" class="form-control bg-dark text-white border-secondary" required />
            </div>
            <div class="col-md-4">
                <label class="form-label text-white-50">Año de Publicación</label>
                <input type="number" id="PublicationYear" name="PublicationYear" class="form-control bg-dark text-white border-secondary" required />
            </div>
            <div class="col-md-4">
                <label class="form-label text-white-50">Descripción</label>
                <input type="text" id="Description" name="Description" class="form-control bg-dark text-white border-secondary" placeholder="Breve descripción" required />
            </div>
            <div class="col-md-4">
                <label class="form-label text-white-50">ID del Autor (authorIds)</label>
                <input type="number" id="authorIdForm" name="autorIdForm" class="form-control bg-dark text-white border-secondary" placeholder="Ej. 1" required />
            </div>
            <div class="col-md-4">
                <label class="form-label text-white-50">ID de la Categoría (categoriaIds)</label>
                <input type="number" id="categoriaIdForm" name="categoriaIdForm" class="form-control bg-dark text-white border-secondary" placeholder="Ej. 2" required />
            </div>

            <div class="col-12 d-flex justify-content-end gap-2 mt-3">
                <button type="submit" id="btn-submit-libro" class="btn btn-warning fw-bold px-4">Guardar</button>
                <button type="button" id="btn-cancelar-libro" class="btn btn-outline-secondary fw-bold d-none px-4" onclick="cancelarEdicionLibro()">Cancelar</button>
            </div>
        </form>
    </div>

    <div class="card p-4" style="background-color: #1c2541; border: none;">
        <h4 class="mb-3 text-white">Listado de Libros en Sistema</h4>
        <div class="table-responsive">
            <table class="table table-dark table-hover align-middle">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Título</th>
                        <th>Género</th>
                        <th>Año</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var libro in Model)
                    {
                        <tr>
                            <td>@libro.Id</td>
                            <td>@libro.Title</td>
                            <td>@libro.Genre</td>
                            <td>@libro.PublicationYear</td>
                            <td>
                                <button type="button" class="btn btn-sm btn-outline-warning me-1"
                                        onclick="cargarParaEditarLibro('@libro.Id', '@libro.Title', '@libro.Genre', '@libro.PublicationYear', '@libro.Description')">
                                    Modificar
                                </button>

                                <form asp-action="Delete" method="post" style="display:inline;" onsubmit="confirmarAccionForm(event, this, '¿Eliminar libro?', '¿Estás seguro de eliminar este libro?')">
                                    <input type="hidden" name="id" value="@libro.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Eliminar</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="mt-3">
        <a asp-action="Index" class="btn btn-secondary">Volver al Panel</a>
    </div>
</div>

@section Scripts {
    <script>
        function cargarParaEditarLibro(id, title, genre, publicationYear, description) {
            const form = document.getElementById('libro-form');
            form.action = '@Url.Action("Edit", "Book")/' + id;

            document.getElementById('LibroId').value = id;
            document.getElementById('Title').value = title;
            document.getElementById('Genre').value = genre;
            document.getElementById('PublicationYear').value = publicationYear;
            document.getElementById('Description').value = description || '';

            document.getElementById('form-titulo-libro').innerText = "Modificar Libro (ID: " + id + ")";
            const btnSubmit = document.getElementById('btn-submit-libro');
            btnSubmit.innerText = "Actualizar";
            btnSubmit.classList.remove('btn-warning');
            btnSubmit.classList.add('btn-success');

            document.getElementById('btn-cancelar-libro').classList.remove('d-none');
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        function cancelarEdicionLibro() {
            const form = document.getElementById('libro-form');
            form.action = '@Url.Action("Create", "Book")';

            document.getElementById('LibroId').value = "0";
            form.reset();

            document.getElementById('form-titulo-libro').innerText = "Registrar Nuevo Libro";
            const btnSubmit = document.getElementById('btn-submit-libro');
            btnSubmit.innerText = "Guardar";
            btnSubmit.classList.remove('btn-success');
            btnSubmit.classList.add('btn-warning');

            document.getElementById('btn-cancelar-libro').classList.add('d-none');
        }
    </script>
}