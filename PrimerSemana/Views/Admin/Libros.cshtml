@model IEnumerable<PrimerSemana.Models.Libro>

@{
    ViewData["Title"] = "Gestión de Libros";
}

<div class="container mt-4 text-white">
    <h2 class="text-warning mb-4">Gestión de Libros</h2>

    <!-- Formulario Dinámico para Registrar o Modificar Libros -->
    <div class="card p-4 mb-5" style="background-color: #1c2541; border: none;">
        <h4 id="form-titulo-libro" class="mb-3 text-white">Registrar Nuevo Libro</h4>
        <form id="libro-form" asp-action="CrearLibro" method="post" class="row g-3">

            <div class="col-md-3">
                <label class="form-label text-white-50">Título</label>
                <input type="text" id="Titulo" name="Titulo" class="form-control bg-dark text-white border-secondary" required />
            </div>
            <div class="col-md-3">
                <label class="form-label text-white-50">Autor</label>
                <input type="text" id="Autor" name="Autor" class="form-control bg-dark text-white border-secondary" required />
            </div>
            <div class="col-md-2">
                <label class="form-label text-white-50">Categoría</label>
                <input type="text" id="Categoria" name="Categoria" class="form-control bg-dark text-white border-secondary" required />
            </div>
            <div class="col-md-2">
                <label class="form-label text-white-50">Precio ($)</label>
                <input type="number" step="0.01" id="Precio" name="Precio" class="form-control bg-dark text-white border-secondary" required />
            </div>
            <div class="col-md-2 d-flex align-items-end gap-2">
                <button type="submit" id="btn-submit-libro" class="btn btn-warning w-100 fw-bold">Guardar</button>
                <button type="button" id="btn-cancelar-libro" class="btn btn-outline-secondary w-100 fw-bold d-none" onclick="cancelarEdicionLibro()">Cancelar</button>
            </div>
        </form>
    </div>

    <!-- Tabla de Libros -->
    <div class="card p-4" style="background-color: #1c2541; border: none;">
        <h4 class="mb-3 text-white">Listado de Libros en Sistema</h4>
        <div class="table-responsive">
            <table class="table table-dark table-hover align-middle">
                <thead>
                    <tr>
                        <th>Título</th>
                        <th>Autor</th>
                        <th>Categoría</th>
                        <th>Precio</th>
                        <th>Disponibilidad</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var libro in Model)
                    {
                        <tr>
                            <td>@libro.Titulo</td>
                            <td>@libro.Autor</td>
                            <td>@libro.Categoria</td>
                            <td>$@libro.Precio</td>
                            <td>
                                @if (libro.Disponible)
                                {
                                    <span class="badge bg-success">Disponible</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">No Disponible</span>
                                }
                            </td>
                            <td>
                                <!-- Botón Modificar que carga los datos aquí mismo -->
                                <button type="button" class="btn btn-sm btn-outline-warning me-1"
                                        onclick="cargarParaEditarLibro('@libro.Titulo', '@libro.Autor', '@libro.Categoria', '@libro.Precio')">
                                    Modificar
                                </button>

                                <!-- Botón Cambiar Estado / Disponibilidad -->
                                <form asp-action="CambiarEstadoLibro" method="post" style="display:inline;">
                                    <input type="hidden" name="titulo" value="@libro.Titulo" />
                                    <button type="submit" class="btn btn-sm @(libro.Disponible ? "btn-outline-danger" : "btn-outline-success")">
                                        @(libro.Disponible ? "Deshabilitar" : "Habilitar")
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="mt-3">
        <a asp-action="Index" class="btn btn-secondary">Volver al Panel</a>
    </div>
</div>

@section Scripts {
    <script>
        function cargarParaEditarLibro(titulo, autor, categoria, precio) {
            const form = document.getElementById('libro-form');
            form.action = '@Url.Action("EditarLibro", "Admin")';

            const inputTitulo = document.getElementById('Titulo');
            inputTitulo.value = titulo;
            inputTitulo.readOnly = true;

            document.getElementById('Autor').value = autor;
            document.getElementById('Categoria').value = categoria;
            document.getElementById('Precio').value = precio;

            document.getElementById('form-titulo-libro').innerText = "Modificar Libro: " + titulo;
            const btnSubmit = document.getElementById('btn-submit-libro');
            btnSubmit.innerText = "Actualizar";
            btnSubmit.classList.remove('btn-warning');
            btnSubmit.classList.add('btn-success');

            document.getElementById('btn-cancelar-libro').classList.remove('d-none');
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        function cancelarEdicionLibro() {
            const form = document.getElementById('libro-form');
            form.action = '@Url.Action("CrearLibro", "Admin")';

            const inputTitulo = document.getElementById('Titulo');
            inputTitulo.value = "";
            inputTitulo.readOnly = false;

            form.reset();

            document.getElementById('form-titulo-libro').innerText = "Registrar Nuevo Libro";
            const btnSubmit = document.getElementById('btn-submit-libro');
            btnSubmit.innerText = "Guardar";
            btnSubmit.classList.remove('btn-success');
            btnSubmit.classList.add('btn-warning');

            document.getElementById('btn-cancelar-libro').classList.add('d-none');
        }
    </script>
}