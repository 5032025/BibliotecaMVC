@model PrimerSemana.Models.Usuario

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card custom-card p-4">
                <h3 class="text-white mb-4">Mi perfil</h3>
                <form asp-action="Editar" method="post">
                    <div class="mb-3">
                        <label class="text-white-50">Correo Electrónico</label>
                        <input asp-for="Email" class="form-control bg-dark text-white border-secondary" />
                    </div>
                    <div class="mb-3">
                        <label class="text-white-50">Ubicación</label>
                        <input asp-for="Ubicacion" class="form-control bg-dark text-white border-secondary" />
                    </div>
                    <div class="mb-3">
                        <label class="text-white-50">Edad</label>
                        <input asp-for="Edad" type="number" class="form-control bg-dark text-white border-secondary" />
                    </div>
                    <button type="submit" class="btn btn-warning w-100 fw-bold">Guardar Cambios</button>
                </form>
            </div>
        </div>
    </div>
</div>