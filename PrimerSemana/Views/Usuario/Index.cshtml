@model PrimerSemana.Models.Usuario

<main class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card bg-dark text-white border-secondary p-4 shadow-lg">
                <h3 class="text-white mb-4">Mi Perfil</h3>
                <form asp-action="Editar" method="post">
                    <div class="mb-3">
                        <label class="form-label text-white-50">Nombre</label>
                        <input asp-for="FirstName" class="form-control bg-dark text-white border-secondary" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label text-white-50">Apellido</label>
                        <input asp-for="LastName" class="form-control bg-dark text-white border-secondary" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label text-white-50">Correo Electrónico</label>
                        <input asp-for="Email" class="form-control bg-dark text-white border-secondary" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label text-white-50">Teléfono</label>
                        <input asp-for="Tel" class="form-control bg-dark text-white border-secondary" />
                    </div>
                    <button type="submit" class="btn btn-warning w-100 fw-bold">Guardar Cambios</button>
                </form>
            </div>
        </div>
    </div>
</main>