@{
    ViewData["Title"] = "Registro";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Registro - BlibioCore</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
            body {
                background-color: #0b132b;
                color: #ffffff;
                min-height: 100vh;
                display: flex;
                align-items: center;
                justify-content: center;
                padding: 20px 0;
                margin: 0;
                font-family: system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
            }

            .card-auth {
                background-color: #1c2541;
                border: none;
                padding: 2.5rem;
                border-radius: 12px;
                width: 100%;
                max-width: 480px;
                box-shadow: 0 8px 24px rgba(0,0,0,0.5);
            }
                /* Forzar texto blanco en títulos, subtítulos y etiquetas */
                .card-auth h3,
                .card-auth p,
                .card-auth label,
                .text-muted {
                    color: #ffffff !important;
                }

            .form-control {
                background-color: #0b132b;
                border: 1px solid #3a506b;
                color: #ffffff;
            }

                .form-control:focus {
                    background-color: #0b132b;
                    border-color: #ffc107;
                    color: #ffffff;
                    box-shadow: none;
                }

            ::placeholder {
                color: #6c757d !important;
                opacity: 1;
            }

            .btn-warning {
                background-color: #ffc107;
                border-color: #ffc107;
                color: #0b132b;
            }

                .btn-warning:hover {
                    background-color: #e0a800;
                    border-color: #d39e00;
                }
    </style>
</head>
<body>

    <div class="card card-auth">
        <h3 class="text-center mb-1 fw-bold">BlibioCore</h3>
        <p class="text-center mb-4">Crea una nueva cuenta de usuario</p>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger py-2 text-dark" role="alert">
                El correo electrónico ya está registrado o hay datos inválidos.
            </div>
        }

        <form asp-controller="Usuario" asp-action="Register" method="post">
            <div class="mb-3">
                <label class="form-label">Nombre Completo</label>
                <input type="text" name="nombre" class="form-control" required placeholder="Tu nombre" />
            </div>
            <div class="mb-3">
                <label class="form-label">Correo Electrónico</label>
                <input type="email" name="email" class="form-control" required placeholder="usuario@ejemplo.com" />
            </div>
            <div class="mb-3">
                <label class="form-label">Contraseña</label>
                <input type="password" name="password" class="form-control" required placeholder="••••••••" />
            </div>
            <div class="row">
                <div class="col-md-8 mb-3">
                    <label class="form-label">Ubicación</label>
                    <input type="text" name="ubicacion" class="form-control" required placeholder="Ej: San Salvador" />
                </div>
                <div class="col-md-4 mb-3">
                    <label class="form-label">Edad</label>
                    <input type="number" name="edad" class="form-control" required placeholder="25" />
                </div>
            </div>
            <button type="submit" class="btn btn-warning w-100 fw-bold py-2 mt-2">Registrarse</button>
        </form>

        <div class="text-center mt-4">
            <span class="text-muted small">¿Ya tienes una cuenta? </span>
            <a asp-controller="Usuario" asp-action="Login" class="text-warning text-decoration-none small fw-bold">Inicia sesión</a>
        </div>
    </div>

</body>
</html>