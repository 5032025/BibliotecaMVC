@{
    ViewData["Title"] = "Iniciar Sesión";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Iniciar Sesión - BlibioCore</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
            body {
                background-color: #0b132b; /* Fondo oscuro principal */
                color: #ffffff; /* Color de texto global blanco */
                height: 100vh;
                display: flex;
                align-items: center;
                justify-content: center;
                margin: 0;
                font-family: system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
            }

            .card-auth {
                background-color: #1c2541; /* Fondo de la tarjeta (más claro que el body) */
                border: none;
                padding: 2.5rem;
                border-radius: 12px;
                width: 100%;
                max-width: 420px;
                box-shadow: 0 8px 24px rgba(0,0,0,0.5);
            }
                /* Estilos para asegurar que los textos sean blancos */
                .card-auth h3,
                .card-auth p,
                .card-auth label,
                .text-muted {
                    color: #ffffff !important; /* Forzamos blanco en elementos clave */
                }

            .form-control {
                background-color: #0b132b; /* Fondo oscuro en input */
                border: 1px solid #3a506b;
                color: #ffffff; /* Texto del input blanco */
            }

                .form-control:focus {
                    background-color: #0b132b;
                    border-color: #ffc107;
                    color: #ffffff;
                    box-shadow: none;
                }

            ::placeholder {
                color: #6c757d !important; /* Placeholder grisáceo para contraste */
                opacity: 1;
            }

            .btn-warning {
                background-color: #ffc107;
                border-color: #ffc107;
                color: #0b132b;
            }

                .btn-warning:hover {
                    background-color: #e0a800;
                    border-color: #d39e00;
                }
    </style>
</head>
<body>

    <div class="card card-auth">
        <h3 class="text-center mb-1 fw-bold">BlibioCore</h3>
        <p class="text-center mb-4">Inicia sesión para continuar</p>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger py-2 text-dark" role="alert">
                Credenciales incorrectas.
            </div>
        }

        <form asp-controller="Usuario" asp-action="Login" method="post">
            <div class="mb-3">
                <label class="form-label">Correo Electrónico</label>
                <input type="email" name="email" class="form-control" required placeholder="admin@bibliocore.com" />
            </div>
            <div class="mb-3">
                <label class="form-label">Contraseña</label>
                <input type="password" name="password" class="form-control" required placeholder="••••••••" />
            </div>
            <button type="submit" class="btn btn-warning w-100 fw-bold py-2 mt-2">Ingresar</button>
        </form>

        <div class="text-center mt-4">
            <span class="text-muted small">¿No tienes una cuenta? </span>
            <a asp-controller="Usuario" asp-action="Register" class="text-warning text-decoration-none small fw-bold">Regístrate aquí</a>
        </div>
    </div>

</body>
</html>